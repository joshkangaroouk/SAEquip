// Prisma schema for saequip-product-hub backend.
//
// The Supabase DB is now the SOURCE OF TRUTH for all custom product content
// (logos, specs, benefits, applications, downloads). Duda keeps only native
// fields + description. Product content is keyed to a HubProduct by dudaProductId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer), used at runtime
  directUrl = env("DIRECT_URL") // direct connection, used for migrations
}

enum LogoKind {
  SA_LOGO
  CERT_LOGO
}

enum TextItemKind {
  BENEFIT
  APPLICATION
}

/// The hub-side record for a Duda product; anchor for all custom content.
model HubProduct {
  id            String   @id @default(cuid())
  dudaProductId String   @unique
  sku           String?
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logos     ProductLogo[]
  specRows  SpecRow[]
  textItems ProductTextItem[]
  downloads Download[]
}

/// An uploaded asset stored in the Supabase Storage bucket.
model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  storagePath String   @unique // path/key in the Supabase Storage bucket
  mimeType    String
  sizeBytes   Int
  kind        String // "image" | "file", derived from mimeType
  alt         String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  logos     Logo[]
  downloads Download[]
}

/// Global logo catalog entry (shared across all products).
model Logo {
  id           String        @id @default(cuid())
  kind         LogoKind
  mediaAssetId String
  label        String?
  alt          String?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  mediaAsset   MediaAsset    @relation(fields: [mediaAssetId], references: [id])
  productLinks ProductLogo[]
}

/// Join: a row means this catalog logo is ACTIVE for this product.
model ProductLogo {
  id           String     @id @default(cuid())
  hubProductId String
  logoId       String
  hubProduct   HubProduct @relation(fields: [hubProductId], references: [id], onDelete: Cascade)
  logo         Logo       @relation(fields: [logoId], references: [id], onDelete: Cascade)

  @@unique([hubProductId, logoId])
}

model SpecRow {
  id           String     @id @default(cuid())
  hubProductId String
  label        String
  value        String
  sortOrder    Int        @default(0)
  hubProduct   HubProduct @relation(fields: [hubProductId], references: [id], onDelete: Cascade)
}

model ProductTextItem {
  id           String       @id @default(cuid())
  hubProductId String
  kind         TextItemKind
  text         String
  sortOrder    Int          @default(0)
  hubProduct   HubProduct   @relation(fields: [hubProductId], references: [id], onDelete: Cascade)
}

model Download {
  id           String     @id @default(cuid())
  hubProductId String
  mediaAssetId String
  title        String
  gated        Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  hubProduct   HubProduct @relation(fields: [hubProductId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])
  leads        Lead[]
}

model Lead {
  id         String   @id @default(cuid())
  downloadId String
  name       String
  email      String
  company    String?
  createdAt  DateTime @default(now())
  download   Download @relation(fields: [downloadId], references: [id], onDelete: Cascade)
}

// Parked for a later step; no editor yet.
model CompatibleLink {
  id           String @id @default(cuid())
  hubProductId String
  relatedSku   String
  sortOrder    Int    @default(0)
}
