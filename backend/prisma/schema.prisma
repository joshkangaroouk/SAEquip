// Prisma schema for saequip-product-hub backend.
//
// The Supabase DB is now the SOURCE OF TRUTH for all custom product content
// (logos, specs, benefits, applications, downloads). Duda keeps only native
// fields + description. Product content is keyed to a HubProduct by dudaProductId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer), used at runtime
  directUrl = env("DIRECT_URL") // direct connection, used for migrations
}

enum LogoKind {
  SA_LOGO
  CERT_LOGO
}

enum TextItemKind {
  BENEFIT
  APPLICATION
}

/// The hub-side record for a Duda product; anchor for all custom content.
model HubProduct {
  id            String   @id @default(cuid())
  dudaProductId String   @unique
  slug          String?  @unique
  sku           String?
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logos     ProductLogo[]
  specRows  SpecRow[]
  textItems ProductTextItem[]
  downloads Download[]

  /// The product's interactive 3D model (.glb), if any. Per-product, unlike the
  /// shared Logo catalog — one model belongs to exactly one product. Public and
  /// ungated: the live widget's <model-viewer> loads it directly by URL.
  glbAssetId String?
  glbAsset   MediaAsset? @relation("HubProductGlbAsset", fields: [glbAssetId], references: [id])
}

/// An uploaded asset stored in the Supabase Storage bucket.
model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  storagePath String   @unique // path/key in the Supabase Storage bucket
  mimeType    String
  sizeBytes   Int
  kind        String // "image" | "file" | "model", derived from mimeType/extension
  alt         String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  logos     Logo[]
  downloads Download[]
  glbFor    HubProduct[] @relation("HubProductGlbAsset")
}

/// Global logo catalog entry (shared across all products).
model Logo {
  id           String        @id @default(cuid())
  kind         LogoKind
  mediaAssetId String
  label        String?
  alt          String?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  mediaAsset   MediaAsset    @relation(fields: [mediaAssetId], references: [id])
  productLinks ProductLogo[]
}

/// Join: a row means this catalog logo is ACTIVE for this product.
model ProductLogo {
  id           String     @id @default(cuid())
  hubProductId String
  logoId       String
  hubProduct   HubProduct @relation(fields: [hubProductId], references: [id], onDelete: Cascade)
  logo         Logo       @relation(fields: [logoId], references: [id], onDelete: Cascade)

  @@unique([hubProductId, logoId])
}

model SpecRow {
  id           String     @id @default(cuid())
  hubProductId String
  label        String
  value        String
  sortOrder    Int        @default(0)
  hubProduct   HubProduct @relation(fields: [hubProductId], references: [id], onDelete: Cascade)
}

model ProductTextItem {
  id           String       @id @default(cuid())
  hubProductId String
  kind         TextItemKind
  text         String
  sortOrder    Int          @default(0)
  hubProduct   HubProduct   @relation(fields: [hubProductId], references: [id], onDelete: Cascade)
}

model Download {
  id           String     @id @default(cuid())
  hubProductId String
  mediaAssetId String
  title        String
  gated        Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  hubProduct   HubProduct @relation(fields: [hubProductId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])
  leads        Lead[]
}

/// A lead captured by a gated download's form.
///
/// Leads OUTLIVE the download and product they came from: deleting a product
/// must not destroy captured business data. That is why `downloadId` is
/// nullable with SetNull rather than Cascade, and why the product/download
/// identity is snapshotted onto the row at capture time — the same
/// denormalised approach QuoteRequestItem already uses. A null downloadId
/// means "the product this came from has since been deleted".
model Lead {
  id            String    @id @default(cuid())
  downloadId    String?
  name          String
  email         String
  company       String?
  createdAt     DateTime  @default(now())
  // Snapshot of where this lead came from, written at capture time so the row
  // stays self-describing after the download or product is gone.
  productName   String?
  productSku    String?
  downloadTitle String?
  download      Download? @relation(fields: [downloadId], references: [id], onDelete: SetNull)
}

// Parked for a later step; no editor yet.
model CompatibleLink {
  id           String @id @default(cuid())
  hubProductId String
  relatedSku   String
  sortOrder    Int    @default(0)
}

/// A quote request submitted via the public basket-page widget (replaces the
/// legacy quote-mailer.php). Email notification is optional; emailSent tracks
/// whether Resend actually sent the alert.
model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String?
  createdAt DateTime @default(now())
  emailSent Boolean  @default(false)
  items     QuoteRequestItem[]
}

model QuoteRequestItem {
  id             String       @id @default(cuid())
  quoteRequestId String
  name           String
  sku            String?
  options        Json?
  price          String?
  quantity       Int          @default(1)
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
}

/// Maps a Hub staff member (Supabase identity) to their own Duda CLIENT
/// account, used to SSO them into the Duda site editor.
///
/// One account per person — never a shared account — so Duda's own site
/// activity log attributes edits to a real individual, and revoking one
/// person doesn't affect anyone else.
///
/// Rows are created ONLY by the provisioning script (`duda:editor-provision`),
/// never by an HTTP route: creating Duda accounts and granting site
/// permissions are privilege-escalating operations, so exposing them to an
/// authenticated endpoint would let any allowed-domain session self-provision.
model DudaEditorAccount {
  id              String   @id @default(cuid())
  /// Supabase auth user id. The SSO route resolves the Duda account from the
  /// verified JWT via this column — the client never supplies an account name.
  staffUserId     String   @unique
  staffEmail      String
  /// The account_name in Duda (the person's real email).
  dudaAccountName String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  siteAccess DudaEditorSiteAccess[]
}

/// Per-user, per-site allowlist — this IS the authorization boundary for SSO.
///
/// A site is reachable only if it has an explicit row here, so any site in the
/// Duda account that was never granted (e.g. the unpublished `8a8f03b5`
/// rebuild) is unreachable by default rather than by omission of a check.
model DudaEditorSiteAccess {
  id                  String            @id @default(cuid())
  dudaEditorAccountId String
  /// Duda site_name, e.g. "099434f3".
  siteName            String
  /// Snapshot of the permission set granted in Duda at provisioning time, for
  /// auditing. Duda remains the source of truth; this is a record of intent.
  grantedPermissions  String[]
  createdAt           DateTime          @default(now())
  account             DudaEditorAccount @relation(fields: [dudaEditorAccountId], references: [id], onDelete: Cascade)

  @@unique([dudaEditorAccountId, siteName])
}

/// Append-only audit of every attempt to mint a Duda editor SSO link.
///
/// An SSO link is a bearer credential, so who requested editor access and
/// when is security-relevant on its own. Identity is snapshotted (plain
/// columns, no FK — Supabase owns identity) so rows stay self-describing after
/// a mapping is revoked, the same rationale as the Lead model.
///
/// Deliberately has NO url/token column: the minted link must never be
/// persisted, cached or logged anywhere.
model DudaSsoAudit {
  id              String   @id @default(cuid())
  staffUserId     String
  staffEmail      String
  siteName        String
  /// Null when the request was denied before an account was resolved.
  dudaAccountName String?
  /// "granted" | "denied_no_mapping" | "denied_site_not_granted" | "duda_error"
  outcome         String
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())
}
