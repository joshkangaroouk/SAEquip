# Backend server port
PORT=4000

# --- Supabase Postgres ---
# Pooled connection (PgBouncer) — used by the app at runtime.
# Supabase → Project Settings → Database → Connection string → "Transaction" pooler.
# Port 6543 and must end with ?pgbouncer=true
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection — used by Prisma for migrations (no pooler).
# Same page → "Session" / direct connection. Port 5432.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (server-side) ---
# Supabase → Project Settings → API
SUPABASE_URL="https://<ref>.supabase.co"
# Service role key — SECRET, server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated email domains allowed to authenticate.
ALLOWED_EMAIL_DOMAINS="kangaroouk.com,saequip.com"

# Comma-separated origins allowed to call the PUBLIC widget API (/public/*).
# Include localhost origins for local widget testing (test harness / Vite dev).
# Origins allowed to call /public/* (the widget). Exact match, no trailing slashes.
# Renamed from PUBLIC_ALLOWED_ORIGINS: Vercel treats a PUBLIC_ prefix as a
# framework 'public' marker, refuses to store it as a Secret, and some
# frameworks would inline it into the client bundle. The name also misread as
# 'safe to expose' when it actually means 'who may call our public API'.
# ⚠️ Vercel PRE-FILLS its env-var form from this file, so a wrong value here
# gets deployed by default. The live Duda site is saequip.multiscreensite.com
# (site 8a8f03b5 — the domain moved during the migration; see CLAUDE.md).
# https://my.duda.co is the Duda EDITOR origin — needed so Widget Builder
# widgets can fetch content and show real data while editing the template.
# Negligible exposure: this endpoint serves content already public on the site.
# Keep localhost entries OUT of the deployed value; they are dev-only.
WIDGET_ALLOWED_ORIGINS="https://my.duda.co,https://saequip.multiscreensite.com,https://saequip.com,https://www.saequip.com,http://localhost:5173,http://localhost:4000"

# --- Duda REST API (REQUIRED — the app refuses to boot without these) ---
# Credentials belong to the agency-level partner account. See CLAUDE.md:
# an SSO link is a bearer credential, so these never reach the browser.
DUDA_API_USER=
DUDA_API_PASS=
# Optional; defaults to https://api.duda.co/api
# DUDA_API_BASE_URL=https://api.duda.co/api
# The live site. 8a8f03b5 since 2026-09-07 — do NOT infer this from the
# domain, or the domain from it; they moved independently. Ask the API.
DUDA_SITE_NAME=8a8f03b5

# --- Resend (OPTIONAL — quote-request notification email) ---
# All THREE or none: isEmailConfigured() requires the full set, and until it
# is satisfied quote requests are still stored, just not emailed.
RESEND_API_KEY=
QUOTE_NOTIFY_FROM=
QUOTE_NOTIFY_TO=
