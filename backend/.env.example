# Backend server port
PORT=4000

# SQLite database location (used by Prisma). Relative paths are resolved from
# the prisma/ schema directory, so this puts the file at backend/dev.db.
DATABASE_URL="file:../dev.db"

# --- Duda API (not required yet; wired up in a later step) ---
# API user/pass from your Duda API credentials
DUDA_API_USER=
DUDA_API_PASS=
# Duda API base URL
DUDA_API_BASE_URL="https://api.duda.co/api"
# The Duda site to manage
DUDA_SITE_NAME="099434f3"
