dist
.env

# Legacy-catalogue migration working files. The WooCommerce export carries
# private/draft products and pricing, the image archive is ~29MB of binaries,
# and the ledger is machine-local run state — none of it belongs in git.
migration/
*.db
*.db-journal
*.db-wal
*.db-shm
.DS_Store

# Timestamped .env copies taken before a credential change. `.env` alone does
# not match these, and one was a `git add -A` away from committing a live
# database password.
.env.backup*
**/.env.backup*
