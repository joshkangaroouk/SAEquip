{
  "name": "saequip-product-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal product-management dashboard (monorepo).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "check": "sh .githooks/pre-push",
    "check:api": "node scripts/check-api-bundle.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
