# Supabase browser client (safe to expose — anon key is public by design).
# Supabase → Project Settings → API
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_ANON_KEY=

# Backend API base URL.
# ⚠️ LEAVE THIS UNSET IN PRODUCTION. The dashboard and API are one Vercel
# project on one origin, so API_BASE is empty (relative) and /api/... resolves
# to the same deployment. Setting it in Vercel silently points the dashboard
# elsewhere. It only falls back to localhost:4000 under import.meta.env.DEV,
# where Vite (5173) and Express (4000) genuinely are different origins.
# Override locally only to point a local dashboard at a deployed API.
# VITE_API_BASE_URL=
