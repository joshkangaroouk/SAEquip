# Supabase browser client (safe to expose — anon key is public by design).
# Supabase → Project Settings → API
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_ANON_KEY=

# Backend API base URL. Defaults to http://localhost:4000 when unset (local dev).
# In production set this to the deployed backend URL, e.g. https://api.yourdomain.com
VITE_API_BASE_URL="http://localhost:4000"
